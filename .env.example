# Copie para .env e preencha.

# Porta da API (o frontend encaminha /api para cá).
PORT=4000

# Chave da API da Anthropic (https://console.anthropic.com). É cobrada à parte
# do seu plano do Claude. Sem ela, a análise é feita só por palavras-chave.
ANTHROPIC_API_KEY=

# Modelo usado na análise. Haiku 5.5 é o mais barato (~US$ 0,001 por vaga).
# ANTHROPIC_MODEL=claude-haiku-5-5

# Limites mensais de IA (o sistema inteiro). Ao atingir, volta a usar só
# palavras-chave até o mês seguinte.
AI_MONTHLY_MAX_ANALYSES=500
AI_MONTHLY_BUDGET_USD=2

# Pré-filtro: vagas com nota abaixo disso ficam como "pouco compatível"
# e nunca são analisadas automaticamente.
AI_PREFILTER_MIN_SCORE=30

# Vagas com nota abaixo disso nem aparecem na tela (continuam salvas no banco).
MIN_VISIBLE_SCORE=20

# Onde fica o banco SQLite (padrão: ./data/job-analyzer.db).
# DATABASE_PATH=./data/job-analyzer.db
