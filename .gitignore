# =============================================================
# NUNCA VAI PARA O GIT
# =============================================================

# Segredos: variáveis de ambiente (chave da IA etc.).
# Só o modelo .env.example sobe, sem valores reais.
.env
.env.*
**/.env
**/.env.*
!.env.example

# Chaves e certificados (ex.: HTTPS do IIS)
*.pem
*.key
*.pfx
*.p12
*.crt

# Banco de dados: contas, senhas (hash), currículos e vagas
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# =============================================================
# Gerado automaticamente (recriado com npm install / build)
# =============================================================
node_modules/
dist/
coverage/
*.tsbuildinfo

# =============================================================
# Configuração local da máquina
# =============================================================
.claude/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
